# LLM provider: "openai" or "fake" (fake = echo, no API costs)
LLM_PROVIDER=openai
LLM_MODEL=gpt-5.5
# Optional, 0-2. Leave commented out for the model default (GPT-5 reasoning models may reject it)
# LLM_TEMPERATURE=0.7
OPENAI_API_KEY=
# Optional: prices in USD per 1M tokens for the cost estimate, merged over the built-in table
# (core/pricing.py). Snapshot names like gpt-5.5-2026-04-23 use the base model's price.
# LLM_PRICES={"gpt-5.5": {"input": 5.0, "cached_input": 0.5, "output": 30.0}}

SYSTEM_PROMPT=You are a helpful assistant.

# Token validation (prepared, currently only checks that a Bearer token is present)
AUTH_ENABLED=false
