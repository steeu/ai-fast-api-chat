# LLM provider: "openai" or "fake" (fake = echo, no API costs)
LLM_PROVIDER=openai
LLM_MODEL=gpt-5.5
# Optional, 0-2. Leave commented out for the model default (GPT-5 reasoning models may reject it)
# LLM_TEMPERATURE=0.7
OPENAI_API_KEY=
# Optional: prices in USD per 1M tokens for the cost estimate, merged over the built-in table
# (core/pricing.py). Snapshot names like gpt-5.5-2026-04-23 use the base model's price.
# LLM_PRICES={"gpt-5.5": {"input": 5.0, "cached_input": 0.5, "output": 30.0}}
# Fixed USD -> CHF exchange rate; costs are shown in CHF
# USD_TO_CHF=0.80

SYSTEM_PROMPT=You are a helpful assistant.

# API docs at /docs and /openapi.json; off by default (production), handy during development
API_DOCS_ENABLED=true

# Login with Zitadel (see README). With AUTH_ENABLED=true all ZITADEL_* values are required.
AUTH_ENABLED=false
# ZITADEL_ISSUER=https://my-instance.zitadel.cloud
# ZITADEL_CLIENT_ID=
# ZITADEL_PROJECT_ID=
# AUTH_REQUIRED_ROLE=chat-user
